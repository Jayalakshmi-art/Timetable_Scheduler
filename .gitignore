# ============================================================
#  Root-level .gitignore for the Timetable Monorepo
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Environment / Secrets ─────────────────────────────────────
.env
.env.*
!.env.example          # Allow a sample template to be committed

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS generated files ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Vite / React (client) ────────────────────────────────────
*.local

# ── Lock files (optional — keep if you want reproducible installs)
# package-lock.json
# yarn.lock

# ── Misc ──────────────────────────────────────────────────────
*.pem
.cache/
.temp/
tmp/
